# ==========================================================================
# Trovo Tech Solutions — canonical URL enforcement
# Ensures every visitor and search-engine crawler lands on ONE canonical
# form: https://trovotechsolutions.in/... (secure, no www).
# This removes the duplicate URLs that cause "Alternate page with proper
# canonical tag" in Google Search Console.
# ==========================================================================

RewriteEngine On

# 1) Redirect www -> non-www AND strip /index.html in a single hop
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(?:index\.html)?$ https://%1/ [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 2) Redirect /index.html -> https://.../ (the homepage should have one address
#    only). Placed before the HTTPS rule so http://.../index.html is one hop.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]

# 3) Force HTTPS for all remaining requests (non-www HTTP)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --------------------------------------------------------------------------
# Custom Error Document (Coming Soon / 404 handler)
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Optional niceties (safe defaults): small performance wins
# --------------------------------------------------------------------------

# Gzip compression for text assets
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser caching for static assets (cuts repeat-visit load time)
<IfModule mod_expires.c>
 ExpiresActive On
 ExpiresByType text/css "access plus 1 month"
 ExpiresByType application/javascript "access plus 1 month"
 ExpiresByType image/svg+xml "access plus 1 month"
 ExpiresByType image/png "access plus 1 month"
 ExpiresByType image/jpeg "access plus 1 month"
 ExpiresByType image/webp "access plus 1 month"
 ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
